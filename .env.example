# Copy to .env.local for local development, and paste the same values into
# Vercel → Settings → Environment Variables for the deployed app.
#
# Both VITE_SUPABASE_* values are safe to expose in a browser bundle: the anon
# key only grants what the row-level security policies allow. Never put the
# service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Address the "Send by email" button in a bug report opens.
# Leave empty to hide that button (reports are still saved and copyable).
VITE_FEEDBACK_EMAIL=
